{
  "name": "@mtjncn/php84",
  "version": "0.1.1",
  "description": "PHP 8.4 as an Unscripted language pack: php-src's embed SAPI compiled to WebAssembly, for @mtjncn/runtime.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./php_pack.wasm": "./php_pack.wasm"
  },
  "files": [
    "index.js",
    "version.js",
    "php_pack.wasm",
    "README.md",
    "NOTICE",
    "LICENSE-PHP",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/copy-php.js 8.4"
  },
  "peerDependencies": {
    "@mtjncn/runtime": "^0.1.0"
  },
  "license": "PHP-3.01 AND (MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattsplat/unscripted-js.git",
    "directory": "packages/php84"
  },
  "keywords": [
    "php",
    "php84",
    "webassembly",
    "wasm",
    "unscripted"
  ],
  "author": "Matt Coleman",
  "homepage": "https://github.com/mattsplat/unscripted-js#readme",
  "bugs": {
    "url": "https://github.com/mattsplat/unscripted-js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
