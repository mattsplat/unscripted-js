    "@unscripted/runtime": "^0.1.0"
  },
  "license": "SEE LICENSE IN LICENSE-PHP",
  "repository": { "type": "git", "url": "https://github.com/mattsplat/unscripted", "directory": "npm/packages/php" },
  "keywords": ["php", "webassembly", "wasm", "unscripted"]
}
